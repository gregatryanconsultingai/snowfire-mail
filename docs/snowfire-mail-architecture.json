  "cards": [
    {
      "dot": "orange",
      "title": "Experience",
      "items": [
        "One desktop workspace for Gmail, Contacts, and Calendar",
        "Nested folders, classification labels, search, and attachment workflows",
        "No SnowFire server tier: the desktop talks directly to Google APIs"
      ]
    },
    {
      "dot": "violet",
      "title": "Automation",
      "items": [
        "Exact-sender routing checks Inbox every minute while the app is open",
        "Local snooze recovery and a cancelable 60-second send window"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Context isolation, no renderer Node access, trusted IPC origins, denied web permissions",
        "Sanitized message HTML; remote images blocked by default; scoped Google OAuth",
        "Rules and preferences stay local; credentials prefer the OS keyring"
      ]
    }
  ]
