{
  "name": "snowfire-mail",
  "private": true,
  "version": "0.1.0",
  "description": "A calm, classification-first Gmail desktop client from SnowFire.ai.",
  "author": "SnowFire.ai",
  "desktopName": "snowfire-mail",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "package:linux": "npm run build && electron-builder --linux",
    "preview": "vite preview",
    "desktop": "electron ."
  },
  "dependencies": {
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sanitize-html": "^2.16.1",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "ai.snowfire.mail",
    "productName": "SnowFire Mail",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "build/icon.png", "package.json"],
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Network;Email",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "artifactName": "SnowFire-Mail-${version}.${ext}"
    }
  }
}
